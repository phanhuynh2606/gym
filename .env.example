# MongoDB connection string (mongodb://... or mongodb+srv://...)
MONGODB_URI=

# Clerk authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Webhook signing secret from Clerk Dashboard → Configure → Webhooks → Endpoint.
# Used by /api/webhooks/clerk to sync user.created / user.updated / user.deleted
# events into MongoDB. Optional in dev — without it, users are lazily upserted
# on their first signed-in request, which is fine for testing.
CLERK_WEBHOOK_SECRET=

# Base URL used for SEO (canonical, sitemap, OG image). Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret protecting /api/cron/* endpoints. Vercel cron requests already
# pass `Authorization: Bearer ${CRON_SECRET}` automatically when this env var
# is set. Leave empty in dev — the cron endpoint becomes open in that case so
# you can hit it from curl while testing.
CRON_SECRET=

# One-time bootstrap for the first admin user. After signing in with this
# email, hit `POST /api/admin/promote` to flip `role` to "admin" in Mongo.
# Subsequent admins should be promoted by updating Mongo directly.
INITIAL_ADMIN_EMAIL=

# Cloudinary signed upload for /admin/media. Free tier is enough.
#   Sign up: https://cloudinary.com/users/register/free
#   Find values in Dashboard → Settings → API Keys.
# Leave empty to keep the upload UI in graceful-503 mode.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YouTube Data API v3 key (admin video search).
#   Create at https://console.cloud.google.com/apis/credentials
#   Enable "YouTube Data API v3". Free quota is 10k units/day.
# Leave empty to keep the search panel disabled with a banner.
YOUTUBE_API_KEY=

# OpenAI-compatible LLM for /coach.
#   - OPENAI_API_KEY: any provider that implements the OpenAI chat-completions
#     wire format (OpenAI, OpenRouter, Groq, Together, Anthropic via gateway,
#     Ollama with `--openai`, etc.).
#   - OPENAI_BASE_URL: defaults to https://api.openai.com/v1
#   - OPENAI_MODEL: defaults to gpt-4o-mini
# Leave OPENAI_API_KEY empty to run the coach in deterministic rule-based mode
# (chat still works, replies just come from a built-in advisor instead of LLM).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
